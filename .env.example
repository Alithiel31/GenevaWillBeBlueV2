# Copiez ce fichier en .env et remplissez les valeurs avant de lancer `docker-compose up --build`.

POSTGRES_USER=agent_blue
POSTGRES_PASSWORD=change_me
POSTGRES_DB=genevawillbeblue

# Utilisé directement par l'app si vous ne passez pas par docker-compose.
# DATABASE_URL=postgres://agent_blue:change_me@localhost:5432/genevawillbeblue

# À définir uniquement si votre hébergeur Postgres utilise un certificat TLS
# auto-signé (ex: proxy Railway) et que la vérification stricte échoue.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
